#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# REMOVE SYSTEM CONFIGURATION
#=================================================
ynh_script_progression "Removing system configurations related to $app..."

ynh_systemctl --service="$I2PD_UNIT" --action="stop"

if ynh_hide_warnings yunohost service status "$I2PD_UNIT" >/dev/null 2>&1; then
    yunohost service remove "$I2PD_UNIT"
fi

ynh_config_remove_nginx

# Our drop-in on the deb's unit (the unit itself belongs to the deb)
ynh_safe_rm "/etc/systemd/system/${I2PD_UNIT}.service.d/$app.conf"
systemctl daemon-reload

#=================================================
# REMOVE UPSTREAM PACKAGE
#=================================================
ynh_script_progression "Purging the upstream i2pd package..."

DEBIAN_FRONTEND=noninteractive apt-get -y purge i2pd

# /var/lib/i2pd (router identity, netDb) survives plain remove so reinstall resumes as the same router; delete only on --purge.
if [ "${YNH_APP_PURGE:-0}" = "1" ]; then
    ynh_safe_rm "$I2PD_DATA_DIR"
fi

ynh_safe_rm "$I2PD_CONFD"

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Removal of $app completed"
