#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source _common.sh
source /usr/share/yunohost/helpers

### settings after install: $port_http/$port_socks/$port_sam (string asks)
### ports resource: $port (webconsole, loopback), $port_ext (I2NP peer, firewalled)

#=================================================
# INITIALIZE AND STORE SETTINGS
#=================================================

# SAM 7656 belongs to whichever router app came first; fall back to 7666 if taken
port_busy() { ss -ltn 2>/dev/null | grep -qE "[:.]$1([[:space:]]|\$)"; }
if port_busy "$port_sam"; then
    if port_busy 7666; then
        ynh_die "Neither SAM port $port_sam nor the fallback 7666 is free. Stop the other router or choose another port."
    fi
    ynh_print_warn "SAM port $port_sam is already in use (another I2P router?); using 7666 for $app's SAM bridge."
    port_sam=7666
    ynh_app_setting_set --key=port_sam --value=$port_sam
fi

# SAM datagram (UDP) port: upstream convention is one below the TCP port.
port_sam_udp=$((port_sam - 1))
ynh_app_setting_set --key=port_sam_udp --value=$port_sam_udp

#=================================================
# SANITY CHECKS
#=================================================

# loopback ports must be free; java_i2p shares the 4444/7656 upstream defaults
ynh_check_tcp_port_free "$port_http"
ynh_check_tcp_port_free "$port_socks"
ynh_check_tcp_port_free "$port_sam"

#=================================================
# APP INITIAL CONFIGURATION
#=================================================
ynh_script_progression "Adding i2pd's configuration files..."

# write our ports BEFORE the deb install: postinst auto-starts i2pd which
# would otherwise bind the 4444/7656 defaults java_i2p also uses
mkdir -p "$I2PD_CONFD/tunnels.conf.d"

# unit/AppArmor/user/datadir come from the deb; we only manage configuration
ynh_config_add --template="i2pd.conf" --destination="$I2PD_CONFD/i2pd.conf"
ynh_config_add --template="tunnels.conf" --destination="$I2PD_CONFD/tunnels.conf"

# keep 644: the i2pd user must read conffiles the deb ships as root:root 644
chmod 644 "$I2PD_CONFD/i2pd.conf" "$I2PD_CONFD/tunnels.conf"

#=================================================
# INSTALL UPSTREAM PACKAGE
#=================================================
ynh_script_progression "Installing upstream i2pd from its pinned release deb..."

install_i2pd_deb

# postinst already started i2pd on our ports; stop it until the rest is laid down
ynh_systemctl --service="$I2PD_UNIT" --action="stop"

#=================================================
# SYSTEM CONFIGURATION
#=================================================
ynh_script_progression "Adding system configurations related to i2pd..."

# Restart-policy hardening for the deb's unit, as a tracked drop-in
mkdir -p "/etc/systemd/system/${I2PD_UNIT}.service.d"
ynh_config_add --template="systemd-override.conf" \
    --destination="/etc/systemd/system/${I2PD_UNIT}.service.d/$app.conf"
systemctl daemon-reload
systemctl enable "$I2PD_UNIT" --quiet

# Create the dedicated NGINX config using the conf/nginx.conf template
ynh_config_add_nginx

# Tile logo for the SSO portal (supported override for non-catalog apps)
if [ -f "$YNH_APP_BASEDIR/logos/i2pd.png" ]; then
    cp "$YNH_APP_BASEDIR/logos/i2pd.png" "/usr/share/yunohost/applogos/$app.png"
    yunohost user permission update "$app.main" --logo "/usr/share/yunohost/applogos/$app.png" || true
fi

yunohost service add "$I2PD_UNIT" \
    --description="i2pd, the C++ I2P router" \
    --log="/var/log/i2pd/i2pd.log"

#=================================================
# START SERVICE
#=================================================
ynh_script_progression "Starting i2pd..."

ynh_systemctl --service="$I2PD_UNIT" --action="start"
ynh_wait_webconsole

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Installation of i2pd completed"
